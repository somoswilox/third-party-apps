<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- [26.392] Nivel «Administrador» del selector Mercado Libre (categoría/privilegio de meli_oerp). Implica
         Encargado (=> Lector). NO implica odoo_connector_api.group_ocapi_connectors_manager (test_26304). -->
    <record id="group_mercadolibre_connectors_manager" model="res.groups">
        <field name="name">MercadoLibre Manager</field>
        <field name="category_id" ref="meli_oerp.module_category_mercadolibre"/>
        <field name="implied_ids" eval="[(4, ref('meli_oerp.group_mercadolibre_manager'))]"/>
        <field name="comment">Administrador: cuentas de Mercado Libre Multiple, vinculaciones y configuración. Incluye Encargado y Lector.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="hide" model="res.groups">
            <field name="name">Hide</field>
            <field name="comment">Hide.</field>
    </record>

    <record model="ir.rule" id="mercadolibre_product_comp_rule">
        <field name="name">MercadoLibre Product multi-company</field>
        <field name="model_id" ref="model_mercadolibre_product"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record model="ir.rule" id="mercadolibre_product_template_comp_rule">
        <field name="name">MercadoLibre Product Template multi-company</field>
        <field name="model_id" ref="model_mercadolibre_product_template"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record model="ir.rule" id="mercadolibre_notification_comp_rule">
        <field name="name">MercadoLibre Notification multi-company</field>
        <field name="model_id" ref="model_mercadolibre_notification"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record model="ir.rule" id="mercadolibre_account_comp_rule">
        <field name="name">MercadoLibre Account multi-company</field>
        <field name="model_id" ref="model_mercadolibre_account"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record model="ir.rule" id="mercadolibre_configuration_comp_rule">
        <field name="name">MercadoLibre Configuration multi-company</field>
        <field name="model_id" ref="model_mercadolibre_configuration"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record model="ir.rule" id="mercadolibre_product_maestro_comp_rule">
        <field name="name">MercadoLibre Product Maestro multi-company</field>
        <field name="model_id" ref="model_mercadolibre_product_maestro"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
