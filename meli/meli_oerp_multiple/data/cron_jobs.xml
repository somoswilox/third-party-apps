<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data noupdate="1">

		<record id="ir_cron_module_internal_jobs" model="ir.cron">
			<field name="name">Meli Internal Jobs</field>
			<field name="active" >True</field>
			<field name="user_id" ref="base.user_root" />
			<field name="interval_number">5</field>
			<field name="interval_type">minutes</field>
			<!--field name="numbercall">-1</field-->
			<!--field eval="False" name="doall" /-->
			<field ref="model_res_company" name="model_id" />
			<field name="state">code</field>
			<field name="code">model.cron_meli_process_internal_jobs()</field>
			<field name="priority">1000</field>
		</record>

		<!-- Drena el buffer de notificaciones de órdenes (webhooks orders_v2 en
		     RECEIVED/FAILED) cada 5 min, independiente del cron de órdenes por
		     consulta (60 min). Sin este cron las notificaciones se acumulan sin
		     drenarse (caso Shoppy: 7.697 RECEIVED). Sólo drena, no consulta la API. -->
		<record id="ir_cron_module_process_order_notifications" model="ir.cron">
			<field name="name">Meli Process Order Notifications</field>
			<field name="active" >True</field>
			<field name="user_id" ref="base.user_root" />
			<field name="interval_number">5</field>
			<field name="interval_type">minutes</field>
			<!--field name="numbercall">-1</field-->
			<!--field eval="False" name="doall" /-->
			<field ref="model_res_company" name="model_id" />
			<field name="state">code</field>
			<field name="code">model.cron_process_order_notifications()</field>
			<field name="priority">1500</field>
		</record>

	</data>
</odoo>
