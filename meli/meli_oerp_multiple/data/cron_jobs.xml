<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data noupdate="1">

		<record id="ir_cron_module_internal_jobs" model="ir.cron">
			<field name="name">Meli Internal Jobs</field>
			<field name="active" >True</field>
			<field name="user_id" ref="base.user_root" />
			<field name="interval_number">5</field>
			<field name="interval_type">minutes</field>
			<!--field name="numbercall">-1</field-->
			<!--field eval="False" name="doall" /-->
			<field ref="model_res_company" name="model_id" />
			<field name="state">code</field>
			<field name="code">model.cron_meli_process_internal_jobs()</field>
			<field name="priority">1000</field>
		</record>

		<!-- Drena el buffer de notificaciones de órdenes (webhooks orders_v2 en
		     RECEIVED/FAILED) cada 5 min, independiente del cron de órdenes por
		     consulta (60 min). Sin este cron las notificaciones se acumulan sin
		     drenarse (caso un cliente: 7.697 RECEIVED). Sólo drena, no consulta la API. -->
		<record id="ir_cron_module_process_order_notifications" model="ir.cron">
			<field name="name">Meli Process Order Notifications</field>
			<field name="active" >True</field>
			<field name="user_id" ref="base.user_root" />
			<field name="interval_number">5</field>
			<field name="interval_type">minutes</field>
			<!--field name="numbercall">-1</field-->
			<!--field eval="False" name="doall" /-->
			<field ref="model_res_company" name="model_id" />
			<field name="state">code</field>
			<field name="code">model.cron_process_order_notifications()</field>
			<field name="priority">1500</field>
		</record>

		<!-- 26.370 (#caso-K67): mensaje postventa automático por estado de envío. Fuera de la importación
		     de órdenes (ninguna llamada de red dentro de esa transacción). No hace nada si ninguna cuenta
		     tiene «Mensaje postventa automático» activo. -->
		<record id="ir_cron_meli_post_sale_auto" model="ir.cron">
			<field name="name">Meli Mensaje Postventa Automático</field>
			<field name="active" >True</field>
			<field name="user_id" ref="base.user_root" />
			<field name="interval_number">15</field>
			<field name="interval_type">minutes</field>
			<!--field name="numbercall">-1</field-->
			<field ref="meli_oerp.model_mercadolibre_orders" name="model_id" />
			<field name="state">code</field>
			<field name="code">model.cron_meli_post_sale_auto()</field>
			<field name="priority">1600</field>
		</record>

	</data>
</odoo>
