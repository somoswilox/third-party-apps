#. module: meli_oerp_accounting
#: model_terms:ir.actions.act_window,help:meli_oerp_accounting.action_mercadolibre_tax
msgid ""
"<strong>Retenciones (ISR, IVA retenido):</strong> para que se apliquen al momento\n"
"                del pago (sin reducir el total de la factura), instalar el módulo\n"
"                <em>Withholding Taxes on Payment</em> (l10n_account_withholding_tax) desde\n"
"                Aplicaciones, y marcar cada impuesto de retención como \"Es retención al pago\"\n"
"                en Contabilidad &gt; Configuración &gt; Impuestos."
msgstr ""
"<strong>Retenções (ISR, IVA retido):</strong> para que sejam aplicadas no momento\n"
" do pagamento (sem reduzir o total da fatura), instale o módulo\n"
" <em>Withholding Taxes on Payment</em> (l10n_account_withholding_tax) a partir de\n"
" Aplicativos e marque cada imposto de retenção como \"É retenção no pagamento\"\n"
" em Contabilidade &gt; Configuração &gt; Impostos."

