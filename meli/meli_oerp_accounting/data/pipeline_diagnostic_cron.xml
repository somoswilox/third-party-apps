<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Cron de diagnostico del pipeline de ventas ML (READ-ONLY).
            Recorre las ventas de MercadoLibre de las ultimas 24h y deja en
            el log un resumen por estado (falta facturar / conciliar / publicar
            / completa). NO ejecuta ninguna accion correctiva.
            Desactivado por defecto (active=False): activarlo cuando se quiera
            el monitoreo diario.
        -->
        <record id="ir_cron_meli_pipeline_diagnostic" model="ir.cron">
            <field name="name">MELI: diagnostico pipeline de ventas (read-only)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_meli_pipeline_diagnostic(hours=24)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
