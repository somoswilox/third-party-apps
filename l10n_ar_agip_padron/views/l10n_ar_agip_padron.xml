<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Vista Lista -->
    <record id="view_l10n_ar_agip_padron_list" model="ir.ui.view">
        <field name="name">l10n_ar.agip.padron.list</field>
        <field name="model">l10n_ar.agip.padron</field>
        <field name="arch" type="xml">
            <list string="Padrón AGIP">
                <field name="archivo_txt"/>
                <field name="fecha_desde"/>
                <field name="fecha_hasta"/>
                <field name="fecha_proceso"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_l10n_ar_agip_padron_form" model="ir.ui.view">
        <field name="name">l10n_ar.agip.padron.form</field>
        <field name="model">l10n_ar.agip.padron</field>
        <field name="arch" type="xml">
            <form string="Detalle Padrón AGIP">
                <sheet>
                    <group>
                        <field name="nombre_archivo" readonly="1"/>
                        <field name="archivo_txt" filename="nombre_archivo"/>
                        <field name="fecha_desde"/>
                        <field name="fecha_hasta"/>
                        <field name="fecha_proceso" readonly="1"/>
                    </group>
                    <p class="alert alert-info" role="alert">
    Este registro contiene el archivo del padrón AGIP cargado. El sistema lo utilizará automáticamente para consultar alícuotas por CUIT al generar comprobantes.
    En caso de que falle la carga de archivos .rar, se recomienda utilizar <a href="https://convertio.co/es/rar-zip/" target="_blank">https://convertio.co/es/rar-zip/</a> para convertir el archivo a formato .zip.
</p>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_l10n_ar_agip_padron" model="ir.actions.act_window">
        <field name="name">Padrones AGIP</field>
        <field name="res_model">l10n_ar.agip.padron</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no se cargó ningún padrón AGIP.
            </p>
            <p>
                Desde aquí podés ver o descargar los archivos .txt del padrón AGIP previamente importados.
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem
        id="menu_l10n_ar_agip_padron"
        name="Padrón AGIP"
        parent="l10n_ar.menu_afip_config"
        action="action_l10n_ar_agip_padron"
        sequence="101"
        
    />

</odoo>
