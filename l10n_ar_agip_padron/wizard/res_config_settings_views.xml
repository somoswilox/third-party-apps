<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form.inherit.l10n_ar_afip_ws</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ar.res_config_settings_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//block[@id='argentina_localization']" position="inside">

                <!-- Grupo de configuración AGIP -->
                <setting id="agip_settings" string="AGIP" company_dependent="1"
                    title="Ingrese las credenciales si utiliza el padrón de AGIP para retenciones/percepciones de IIBB.">
                    <div class="content-group" invisible="country_code != 'AR'">
                        <div class="row mt16">
                            <label for="agip_token" class="col-lg-3 o_light_label" />
                            <field name="agip_token" />
                        </div>
                        <div class="row mt16">
                            <label for="agip_sign" class="col-lg-3 o_light_label" />
                            <field name="agip_sign" password="True" />
                        </div>
                        <div class="row mt16">
                            <button name="l10n_ar_agip_test_connection" type="object"
                                class="oe_link oe_inline" string="⇒ Verificar Clave AGIP" />
                        </div>

                    </div>
                </setting>
            </xpath>

        </field>
    </record>
</odoo>