<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.benefit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Sunat" string="Sunat" name="pc_l10n_pe_vat_sunat" groups="account.group_account_manager">
                    <block title="Data from SUNAT" id="data_sunat">
                        <setting id="enable_annexed_locals" company_dependent="1" help="Get annexed locals from SUNAT website" title="Allow to get annexed locals from SUNAT website.">
                            <field name="annexed_locals"/>
                        </setting>
                        <setting id="enable_legal_representatives" company_dependent="1" help="Get legal representives from SUNAT website" title="Allow to get legal representives from SUNAT website.">
                            <field name="legal_representatives"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="l10n_pe_vat_sunat_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'pc_l10n_pe_vat_sunat'}</field>
    </record>
    
    <menuitem name="Settings" parent="contacts.res_partner_menu_config" groups="base.group_system" id="sunat_settings" sequence="0" action="l10n_pe_vat_sunat_config_settings_action"/>

</odoo>
