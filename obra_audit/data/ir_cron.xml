<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Cron diario que genera el snapshot.

            nextcall: 02:45 UTC del dia siguiente a la instalacion.
            02:45 UTC = 23:45 hora Argentina (UTC-3).

            interval: 1 dia. A partir de la primera corrida, Odoo suma
            1 dia automaticamente a nextcall, manteniendo el horario.
        -->
        <record id="ir_cron_obra_audit_daily_snapshot" model="ir.cron">
            <field name="name">Obra Audit: Snapshot diario de tareas</field>
            <field name="model_id" ref="model_obra_task_daily_snapshot"/>
            <field name="state">code</field>
            <field name="code">model._generate_daily_snapshot()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=2, minute=45, second=0, microsecond=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
